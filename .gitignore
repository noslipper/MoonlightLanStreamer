# ---- 构建产物 ----
bin/
obj/
build/
dist/
*.exe
*.dll
*.pdb
# 注意：src/app.manifest 是编译输入（ApplicationManifest），不能忽略

# ---- 本地生成的运行时包（约 73 MB，由 src/make_runtimes.ps1 生成，不入库）----
runtimes.zip

# ---- 运行时数据（本地配置/日志/证书缓存）----
.runtime/
*.log
*.log.[0-9]
*.bak
*.tmp

# ---- 开发期临时脚本与预览图 ----
scratch/

# ---- 工具/编辑器 ----
.workbuddy/
.idea/
.vscode/
.vs/
*.user
*.suo
*.swp
Thumbs.db
desktop.ini

# ---- 证书/私钥（首次开播时由 Sunshine 按机器生成，切勿入库）----
runtime_config/credentials/*.pem
runtime_config/client_identity/
*.pem
*.pfx
